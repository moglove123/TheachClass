DATABASE_URL="file:./dev.db"
# ต้องเป็นรหัสสุ่มอย่างน้อย 24 ตัวอักษร (production จะบล็อกถ้าใช้ค่าตัวอย่าง/สั้นเกินไป)
JWT_SECRET="change-this-secret-in-production"
PORT=4000
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=20
# production: ตั้งค่าบริการอีเมลภายนอกเพื่อส่งลิงก์ reset password
# รับ JSON { to, subject, text, token, resetUrl } แบบ POST
EMAIL_API_URL=""
EMAIL_API_KEY=""
# ลิงก์หน้าเว็บจริง ใช้ประกอบ resetUrl ในอีเมล
APP_BASE_URL="http://localhost:5173"
