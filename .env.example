# Prisma Postgres: ใช้ host แบบ pooled สำหรับ runtime แบบ direct (db.prisma.io) สำหรับ prisma db push/migrate
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require&connect_timeout=15"
# DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require&connect_timeout=15"
# ต้องเป็นรหัสสุ่มอย่างน้อย 24 ตัวอักษร (production จะบล็อกถ้าใช้ค่าตัวอย่าง/สั้นเกินไป)
JWT_SECRET="change-this-secret-in-production"
PORT=4000
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=20
# production: Resend ใช้ส่งลิงก์ reset password (ต้องตั้ง RESEND_API_KEY บน Vercel ด้วย)
RESEND_API_KEY=""
# ต้องเป็น domain ที่ verify ใน Resend (ค่าเริ่มต้น onboarding@resend.dev ใช้ได้เฉพาะส่งหาเจ้าของบัญชี)
RESEND_FROM_EMAIL="TheachClass <onboarding@resend.dev>"
# ลิงก์หน้าเว็บจริง ใช้ประกอบลิงก์ reset-password ในอีเมล
APP_BASE_URL="http://localhost:5173"
